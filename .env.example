# KendMart Environment Configurations
# Copy this file to backend/.env and frontend/.env and fill in your values

# --- BACKEND (backend/.env) ---

# PostgreSQL connection (required for production)
DATABASE_URL="postgresql://user:password@host:5432/kendmart?schema=public"

# Admin account credentials
ADMIN_EMAIL="admin@kendmart.az"
ADMIN_PASSWORD="change_this_to_a_strong_password"

# JWT secret for auth tokens (use a long random string; MUST be identical in backend and frontend)
JWT_SECRET="generate_a_long_random_secret_key"

# Comma-separated list of allowed frontend origins for CORS (e.g. https://kendmart.com)
CORS_ORIGINS="https://your-frontend-domain.com"

# Resend API key for password-reset OTP emails
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Cloudinary (optional locally, required for production)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# --- FRONTEND (frontend/.env) ---

# Backend API URL
NEXT_PUBLIC_API_URL="http://localhost:5000"

# Custom admin path (change this to hide the admin panel URL)
ADMIN_PATH="kendmart-admin"
NEXT_PUBLIC_ADMIN_PATH="kendmart-admin"

# Secret key that unlocks the admin login page (set in BOTH backend and frontend).
# Visit /{ADMIN_PATH}?key=YOUR_KEY to see the login form; without it the page returns 404.
# Never use NEXT_PUBLIC_ prefix — keep it server-side only.
ADMIN_ACCESS_KEY="generate_a_long_random_secret_key"
